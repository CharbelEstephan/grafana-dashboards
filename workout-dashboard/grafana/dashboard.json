    {
      "type": "timeseries",
      "title": "Total Reps per Session (weekly avg)",
      "id": 19,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRES}"
      },
      "gridPos": {
        "x": 8,
        "y": 31,
        "w": 8,
        "h": 8
