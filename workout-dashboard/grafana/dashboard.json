      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRES}"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('week', s.starttime)::date AS time, avg(ss.total_reps) AS \"reps/session\" FROM workout.v_session_stats ss JOIN workout.sessions s ON s.id = ss.session_id WHERE s.starttime IS NOT NULL AND $__timeFilter(s.starttime) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
