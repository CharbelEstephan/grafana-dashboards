  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Workout Notes",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${DS_POSTGRES}"
        },
        "enable": true,
        "iconColor": "yellow",
        "hide": false,
        "target": {
          "rawQuery": true,
          "rawSql": "SELECT mydate AS time, COALESCE(NULLIF(title,''), mynote) AS text, 'note' AS tags FROM workout.notes WHERE mydate IS NOT NULL AND $__timeFilter(mydate)",
          "format": "table"
        }
      }
    ]
  },
