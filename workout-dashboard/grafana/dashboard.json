          "rawQuery": true,
          "rawSql": "SELECT date_trunc('week', s.starttime)::date AS time, avg(ss.total_sets) AS \"sets/workout\" FROM workout.v_session_stats ss JOIN workout.sessions s ON s.id = ss.session_id WHERE s.starttime IS NOT NULL AND $__timeFilter(s.starttime) GROUP BY 1 ORDER BY 1",
