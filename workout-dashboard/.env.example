# Copy to .env and fill in your Neon connection string.
# Neon dashboard -> your project -> Connection Details -> "psql" / connection string.
# It already includes ?sslmode=require; if yours doesn't, the loader appends it.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
