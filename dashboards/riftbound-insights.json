                        "rawQuery": true,
                        "rawSql": "SELECT location                                              AS \"Location\",\n       COUNT(*)                                                AS \"Games\",\n       ROUND(100.0 * COUNT(*) FILTER (WHERE won) / COUNT(*), 1) AS \"Win %\"\nFROM games\nWHERE location IS NOT NULL AND $__timeFilter(played_on)\nGROUP BY 1\nORDER BY 2 DESC",
