                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT played_on AS time,\n       ROUND(100.0 * SUM(COUNT(*) FILTER (WHERE won)) OVER (ORDER BY played_on)\n                   / SUM(COUNT(*)) OVER (ORDER BY played_on), 1) AS \"Cumulative win %\"\nFROM games\nWHERE $__timeFilter(played_on)\nGROUP BY played_on\nORDER BY played_on",
