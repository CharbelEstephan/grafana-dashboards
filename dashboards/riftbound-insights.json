              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "cftjb82cb5tkwf"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT COUNT(*)                                                        AS \"Games\",\n       COUNT(*) FILTER (WHERE won)                                     AS \"Wins\",\n       COUNT(*) FILTER (WHERE NOT won)                                 AS \"Losses\",\n       COUNT(DISTINCT series_id)                                       AS \"Series\",\n       ROUND(100.0 * COUNT(*) FILTER (WHERE won) / NULLIF(COUNT(*),0), 1) AS \"Win %\"\nFROM games\nWHERE $__timeFilter(played_on)",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Every game logged in the selected time range.",
