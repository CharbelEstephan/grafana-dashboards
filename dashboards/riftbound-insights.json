                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT my_leader || '  (' || COUNT(*) || ')' AS \"Legend\",\n       ROUND(100.0 * COUNT(*) FILTER (WHERE won) / COUNT(*), 1) AS \"Win %\"\nFROM games\nWHERE $__timeFilter(played_on)\nGROUP BY my_leader\nHAVING COUNT(*) \u003e= 5\nORDER BY 2 DESC",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [],
                          "limit": 50
                        }
