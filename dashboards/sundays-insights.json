          "data": {"kind":"QueryGroup","spec":{"queries":[{"kind":"PanelQuery","spec":{"hidden":false,"query":{"datasource":{"name":"cfvidd1r5wni8e"},"group":"grafana-postgresql-datasource","kind":"DataQuery","spec":{"editorMode":"code","format":"table","rawQuery":true,"rawSql":"(SELECT 'Highest' AS \"Kind\", COALESCE(m.alias, m.display_name) AS \"Manager\", ROUND(tw.points, 2) AS \"Points\", tw.season AS \"Season\", tw.week AS \"Week\" FROM team_week tw JOIN seasons s ON s.league_id = tw.league_id LEFT JOIN managers m ON m.user_id = tw.user_id WHERE s.league_group = 'Sundays For the Boys' AND tw.points IS NOT NULL AND tw.matchup_id IS NOT NULL ORDER BY tw.points DESC LIMIT 1) UNION ALL (SELECT 'Lowest', COALESCE(m.alias, m.display_name), ROUND(tw.points, 2), tw.season, tw.week FROM team_week tw JOIN seasons s ON s.league_id = tw.league_id LEFT JOIN managers m ON m.user_id = tw.user_id WHERE s.league_group = 'Sundays For the Boys' AND tw.points IS NOT NULL AND tw.matchup_id IS NOT NULL ORDER BY tw.points ASC LIMIT 1)","sql":{"columns":[{"parameters":[],"type":"function"}],"groupBy":[],"limit":50}},"version":"v0"},"refId":"A"}}],"queryOptions":{},"transformations":[]}},
