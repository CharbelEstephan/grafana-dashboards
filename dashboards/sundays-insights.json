          "data": {"kind":"QueryGroup","spec":{"queries":[{"kind":"PanelQuery","spec":{"hidden":false,"query":{"datasource":{"name":"cfvidd1r5wni8e"},"group":"grafana-postgresql-datasource","kind":"DataQuery","spec":{"editorMode":"code","format":"table","rawQuery":true,"rawSql":"WITH wk AS (SELECT tw.season, tw.week, COALESCE(m.alias, m.display_name) AS manager, RANK() OVER (PARTITION BY tw.league_id, tw.season, tw.week ORDER BY tw.points DESC) AS rk FROM team_week tw JOIN seasons s ON s.league_id = tw.league_id LEFT JOIN managers m ON m.user_id = tw.user_id WHERE s.league_group = 'Sundays For the Boys' AND tw.points IS NOT NULL AND tw.matchup_id IS NOT NULL) SELECT manager AS \"Manager\", COUNT(*) AS \"Top weeks\" FROM wk WHERE rk = 1 GROUP BY manager ORDER BY 2 DESC","sql":{"columns":[{"parameters":[],"type":"function"}],"groupBy":[],"limit":50}},"version":"v0"},"refId":"A"}}],"queryOptions":{},"transformations":[]}},
