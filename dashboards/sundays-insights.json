          "title": "",
          "vizConfig": {"group":"text","kind":"VizConfig","spec":{"fieldConfig":{"defaults":{},"overrides":[]},"options":{"mode":"markdown","content":"### Sundays For the Boys\nThe only league shown here. **Detailed game / trade / draft data: 2023–present** (the Sleeper era). **Champions & toilet bowls go back to 2019**; season standings to 2020. Records that say \"ever\" mean 2023-present unless noted."}},"version":"13.2.0-29988805803"}
