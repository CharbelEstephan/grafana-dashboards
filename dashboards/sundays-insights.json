        "spec": {
          "data": {"kind":"QueryGroup","spec":{"queries":[{"kind":"PanelQuery","spec":{"hidden":false,"query":{"datasource":{"name":"cfvidd1r5wni8e"},"group":"grafana-postgresql-datasource","kind":"DataQuery","spec":{"editorMode":"code","format":"table","rawQuery":true,"rawSql":"SELECT name AS \"Manager\", SUM((name = champion)::int) AS \"Titles\", SUM((name = champion OR name = runner_up)::int) AS \"Final appearances\" FROM history_seasons, LATERAL (VALUES (champion), (runner_up)) v(name) WHERE league_group = 'Sundays For the Boys' AND name IS NOT NULL GROUP BY name HAVING SUM((name = champion OR name = runner_up)::int) > 0 ORDER BY 2 DESC, 3 DESC","sql":{"columns":[{"parameters":[],"type":"function"}],"groupBy":[],"limit":50}},"version":"v0"},"refId":"A"}}],"queryOptions":{},"transformations":[]}},
